/* DeepLab brand (Signal) - https://github.com/fkeil/deeplab-brand */
:root, .theme_light {
  --color-primary-100: 219 230 252;
  --color-primary-300: 127 166 243;
  --color-primary-500: 74 130 240;
  --color-primary-600: 47 111 237;
  --color-primary-700: 37 89 196;
  --color-text-alt2: 255 255 255;
  --color-background-alt2: 15 23 41;
  --color-background-alt3: 22 33 58;
  --color-background-alt4: 15 23 41;
}
.theme_dark {
  --color-primary-100: 22 33 58;
  --color-primary-300: 91 141 239;
  --color-primary-500: 91 141 239;
  --color-primary-600: 91 141 239;
  --color-primary-700: 127 166 243;
  --color-background: 15 23 41;
  --color-background-alt: 22 33 58;
}
